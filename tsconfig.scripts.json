{
  // STRICT TYPES FOR THE LOCAL READINESS PATH.
  //
  // Nothing under `scripts/` was covered by any tsconfig: the root project includes only `src`, and the
  // server project only `server`. vite-node and vitest transpile with esbuild, which does not typecheck,
  // so every script in this repository has been running unchecked. That is the same shape as a test CI
  // never runs — and it had already cost something: `control.ts` passed an `asOf` term to a validator
  // whose terms type has no such field, inert at runtime and a false claim to any reader, found the first
  // time these files were typechecked.
  //
  // `scripts/freeze` joined on 2026-10-16, when the baseline preservation ledger added two more tools
  // there. It was PROBED before being added rather than assumed: all four files typecheck clean, so the
  // coverage costs nothing and the two new tools are held to the same bar as `src/`.
  //
  // Still scoped deliberately. `scripts/pilot-intake/verify-package.ts` carries nine errors of its own
  // (unused bindings and unchecked regex-group indexing); widening to it would mean editing the package
  // verifier inside a slice that does not own it, so that gap stays reported rather than swept in here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"]
  },
  "include": ["scripts/data-readiness/**/*.ts", "scripts/freeze/**/*.ts", "scripts/audit/**/*.ts", "src"]
}
