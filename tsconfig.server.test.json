{
  // TYPECHECK FOR THE SERVER'S OWN TESTS. A SEPARATE PROGRAM, DELIBERATELY.
  //
  // WHY IT IS SEPARATE AND NOT A WIDENING OF `tsconfig.server.json`. That config exists to EMIT the
  // server to `dist-server` as CommonJS, so it sets `module: CommonJS`. The tests are never emitted:
  // vitest runs them through esbuild as ES modules, where `import.meta` is legal. Compiling them under
  // the emit config reports 15 × TS1343 — "import.meta is only allowed when module is es2020/esnext/…" —
  // which is a statement about the WRONG CONFIG being applied, not about the code. Widening the emit
  // config's module to satisfy the tests would change what the production server compiles to, which is
  // the one thing that must not move.
  //
  // SO THE SPLIT IS THE FIX, NOT A WORKAROUND. Production keeps its CommonJS emit program and its hard
  // zero-error gate; the tests get a program whose module system matches how they actually execute.
  //
  // EVERY OTHER STRICTNESS SETTING IS INHERITED UNCHANGED — `strict`, `noUnusedLocals`,
  // `noUnusedParameters`, `noFallthroughCasesInSwitch`. Nothing is loosened to lower the error count, and
  // the count is reported before and after the split so no error can appear to have been fixed by it.
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": true,
    // The module system vitest actually runs these files under. This is the only setting that differs.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vitest/globals"]
  },
  "include": ["server/**/*.ts"],
  "exclude": []
}
