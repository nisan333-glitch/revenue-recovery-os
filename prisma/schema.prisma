// EP-2 · PostgreSQL is the authoritative persistence layer for NH recovery proofs.
//
// Design intent (consistent with the frozen Foundation, enforced — not decorative):
//  * Proof rows are IMMUTABLE, APPEND-ONLY snapshots. The numbers they carry
//    (revenueReturned = collected − baseline, clamped) are computed ONCE by the
//    domain kernel (`createApprovedProof`) and frozen; the DB never recomputes them.
//  * A correction/reversal is a NEW linked row (previousProofId + shared chainId +
//    incremented proofVersion), produced by the kernel's `reviseProof`. The original
//    is never overwritten.
//  * UPDATE and DELETE are rejected at the database level by triggers (see the
//    `ep2_immutability` migration) — direct mutation cannot bypass the kernel.
//  * Provenance/version fields (policyVersion, baselineVersion, proofVersion,
//    confidenceMethodologyVersion, approvedBy, createdAt/approvedAt, persistedAt)
//    are persisted so every counted number stays explainable and reproducible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Immutable, append-only snapshot of an approved (or revised) recovery proof.
/// Mirrors the domain `Proof` interface; money is stored in minor units (BigInt).
model Proof {
  proofId                      String   @id
  recoveryCaseId               String
  chainId                      String
  proofVersion                 Int
  previousProofId              String?
  status                       String // Approved | Reversed | Superseded | Corrected (kernel-controlled)
  currency                     String
  collectedMinor               BigInt
  baselineMinor                BigInt
  revenueReturnedMinor         BigInt // frozen by the kernel; DB stores, never derives
  excludedRecoveryMinor        BigInt
  exclusionStatement           String
  recoveryReason               String
  attribution                  String
  evidenceRefs                 String[]
  baselineId                   String
  baselineMethodId             String
  baselineVersion              Int
  baselineLockPolicy           String
  policyVersion                String
  confidenceMethodologyVersion String
  proofThresholdUsed           Float
  confidenceUsed               Float
  approvedBy                   String
  createdAt                    DateTime
  approvedAt                   DateTime
  persistedAt                  DateTime @default(now()) // provenance: DB write time

  // EP-8.1 · H1 concurrency backstop: at most one row per (chainId, proofVersion) — the
  // exact invariant effectiveProofs() (src/domain/proof.ts) already assumes. A second,
  // complementary partial index UNIQUE(previousProofId) WHERE previousProofId IS NOT NULL
  // (a proof may be superseded at most once) is added via raw SQL in the
  // ep8_1_chain_fork_guard migration — Prisma's @@unique cannot express the WHERE clause
  // NULLs must be exempt from.
  @@unique([chainId, proofVersion])
  @@index([chainId])
  @@index([recoveryCaseId])
  @@index([previousProofId])
}

/// Append-only authority ledger (EP-4): who did what, in which role, on which case.
/// Records every governed action (Author/Approve/Verify/Flag/Halt) with the actor
/// identity, role, policy version, and timestamp. Separation-of-duty enforcement reads
/// this ledger; it is immutable at the DB level so authority history stays auditable.
model AuthorityEvent {
  id             String   @id
  recoveryCaseId String
  actorId        String
  role           String
  action         String // Author | Approve | Verify | Flag | Halt
  policyVersion  String
  at             DateTime @default(now())

  @@index([recoveryCaseId])
  @@index([actorId])
}

/// EP-8.1 · Immutable, append-only baseline snapshot. Establish and lock happen as ONE
/// insert (`lockedAt` is the server clock, never client-suppliable). A proof's baseline
/// amount/method/version come ONLY from the snapshot a case references, never from the
/// approval request body. A correction is a NEW row (`supersedes`); the prior snapshot,
/// and every proof that already stamped it, is never touched.
model BaselineSnapshot {
  baselineId        String   @id
  recoveryCaseId    String
  calculatedMinor   BigInt
  currency          String
  method            String
  methodVersion     Int
  sourceRefs        String[]
  effectiveAt       DateTime
  establishedBy     String
  establishedByRole String
  lockedAt          DateTime @default(now())
  supersedes        String?

  @@index([recoveryCaseId])
}

/// EP-8.1 · Append-only, pre-proof evidence ingestion. Immutable at the DB level.
/// `evidenceRole` and `trustClassification`/`beneficiaryControl` are DERIVED server-side at
/// ingestion (never client-asserted) — see server/domain/evidenceRole.ts and the domain's
/// `makeEvidence`. `roleMapVersion` freezes which allowlist version produced the
/// classification, so a future mapping change can never reinterpret historical evidence.
/// `observedAt` is recorded but is a claimed, non-authoritative fact — see `ingestedAt`
/// (server clock) for the positive timing signal actually used by the temporal trust gate.
/// The partial unique index below makes an outcome-role source record single-use across
/// every recovery, not just within one case.
model EvidenceRecord {
  evidenceId          String   @id
  recoveryCaseId      String
  proofId             String?
  sourceSystem        String
  sourceRecordId      String
  evidenceType        String
  observedAt          DateTime
  amountMinor         BigInt?
  currency            String?
  trustClassification String // "independent" | "beneficiary_controlled" — derived, never asserted
  beneficiaryControl  Boolean
  evidenceRole        String // "outcome" | "supporting" — derived, never asserted
  roleMapVersion      String
  ingestedBy          String
  ingestedByRole      String
  ingestedAt          DateTime @default(now()) // authoritative server timestamp
  sourceVerification  Json?
  note                String?
  // A partial unique index (sourceSystem, sourceRecordId) WHERE evidenceRole='outcome' is
  // added via raw SQL in the ep8_1_evidence_hardening migration — Prisma's declarative
  // @@unique cannot express a WHERE clause, and the constraint must apply to outcome-role
  // rows only (supporting evidence may legitimately be cited more than once).

  @@index([recoveryCaseId])
}

/// EP-12A · Durable execution state for observation-only agents. A task is always scoped to
/// one boundary; its result may contain CandidateSignals only and grants no case/proof authority.
/// Runtime transitions use raw SQL for SKIP LOCKED claiming and fenced lease predicates.
model AgentTaskRecord {
  taskId         String                 @id(map: "agent_tasks_pkey") @map("task_id")
  boundaryId     String                 @map("boundary_id")
  agentId        String                 @map("agent_id")
  idempotencyKey String                 @map("idempotency_key")
  payload        Json
  status         String
  attempt        Int                    @default(0)
  notBefore      DateTime               @map("not_before") @db.Timestamptz(3)
  leaseOwner     String?                @map("lease_owner")
  leaseToken     String?                @map("lease_token")
  leaseExpiresAt DateTime?              @map("lease_expires_at") @db.Timestamptz(3)
  fencingEpoch   BigInt                 @default(0) @map("fencing_epoch")
  result         Json?
  lastError      String?                @map("last_error")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @default(now()) @map("updated_at") @db.Timestamptz(3)
  events         AgentTaskEventRecord[]

  @@unique([boundaryId, agentId, idempotencyKey], map: "agent_tasks_boundary_agent_idempotency_unique")
  @@unique([taskId, boundaryId, agentId], map: "agent_tasks_identity_boundary_unique")
  @@map("agent_tasks")
}

/// Append-only audit history for every durable AgentTask transition. State and event are written
/// in the same PostgreSQL transaction; UPDATE/DELETE/TRUNCATE are rejected by DB triggers.
model AgentTaskEventRecord {
  eventId      String          @id(map: "agent_task_events_pkey") @map("event_id")
  sequence     BigInt          @unique(map: "agent_task_events_sequence_key") @default(autoincrement()) @map("event_sequence")
  taskId       String          @map("task_id")
  boundaryId   String          @map("boundary_id")
  agentId      String          @map("agent_id")
  workerId     String?         @map("worker_id")
  fencingEpoch BigInt          @map("fencing_epoch")
  attempt      Int
  kind         String
  metadata     Json
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  task         AgentTaskRecord @relation(fields: [taskId, boundaryId, agentId], references: [taskId, boundaryId, agentId], onDelete: Restrict, onUpdate: Restrict, map: "agent_task_events_task_boundary_agent_fkey")

  @@index([taskId, sequence], map: "agent_task_events_task_sequence_idx")
  @@index([boundaryId, agentId, sequence], map: "agent_task_events_boundary_agent_sequence_idx")
  @@map("agent_task_events")
}

/// EP-12B · A detector result that crossed the universal admission gate. It remains a
/// hypothesis until a human operator accepts it and explicitly promotes it to a RecoveryCase.
model AgentCaseCandidateRecord {
  candidateId String   @id(map: "agent_case_candidates_pkey") @map("candidate_id")
  dedupeKey   String   @unique(map: "agent_case_candidates_dedupe_key_key") @map("dedupe_key")
  boundaryId  String   @map("boundary_id")
  agentId     String   @map("agent_id")
  signal      Json
  status      String   @default("pending_review")
  submittedAt DateTime @map("submitted_at") @db.Timestamptz(3)
  persistedAt DateTime @default(now()) @map("persisted_at") @db.Timestamptz(3)

  @@unique([candidateId, boundaryId], map: "agent_case_candidates_identity_boundary_unique")
  @@index([boundaryId, status, submittedAt], map: "agent_case_candidates_review_queue_idx")
  @@map("agent_case_candidates")
}

/// Immutable human decision on a candidate. One candidate can be reviewed once; an accepted
/// decision stays visible until the candidate has a durable RecoveryCase root.
model AgentCaseCandidateReviewRecord {
  reviewId      String   @id(map: "agent_case_candidate_reviews_pkey") @map("review_id")
  candidateId   String   @unique(map: "agent_case_candidate_reviews_candidate_key") @map("candidate_id")
  boundaryId    String   @map("boundary_id")
  decision      String
  reason        String
  actorId       String   @map("actor_id")
  actorRole     String   @map("actor_role")
  policyVersion String   @map("policy_version")
  decidedAt     DateTime @default(now()) @map("decided_at") @db.Timestamptz(3)

  @@index([boundaryId, decidedAt], map: "agent_case_candidate_reviews_boundary_idx")
  @@map("agent_case_candidate_reviews")
}

/// EP-12E · Authoritative root of every governed recovery workflow. No baseline, evidence,
/// proof or authority mutation is valid in production without this row.
model RecoveryCaseRecord {
  recoveryCaseId    String   @id(map: "recovery_cases_pkey") @map("recovery_case_id")
  boundaryId        String   @map("boundary_id")
  sourceCandidateId String   @unique(map: "recovery_cases_source_candidate_key") @map("source_candidate_id")
  recoveryType      String   @map("recovery_type")
  sourceRef         String   @map("source_ref")
  amountAtRiskMinor BigInt   @map("amount_at_risk_minor")
  currency          String
  detectorVersion   String   @map("detector_version")
  openedByActorId   String   @map("opened_by_actor_id")
  openedByRole      String   @map("opened_by_role")
  policyVersion     String   @map("policy_version")
  openedAt          DateTime @map("opened_at") @db.Timestamptz(3)
  persistedAt       DateTime @default(now()) @map("persisted_at") @db.Timestamptz(3)

  @@index([boundaryId, openedAt], map: "recovery_cases_boundary_opened_idx")
  @@map("recovery_cases")
}

/// EP-13 · Record of one customer pilot dataset submission. It exists for ONE reason: to make a
/// repeated upload recognisable, so the same exposure is not assessed twice. It is deliberately
/// NOT an evidence, case or proof record and grants no authority whatsoever.
///
/// WHAT IT STORES: the tenant boundary, the customer's dataset label, the deterministic
/// idempotency key, the file fingerprint, counts, and the VALIDATION CODES produced.
/// WHAT IT NEVER STORES: uploaded row content, customer identifiers, monetary values, or the
/// `detail` text of a finding (which can echo a customer value). A rejected row is reported to the
/// uploader and then forgotten — it is never persisted.
model PilotDatasetSubmissionRecord {
  idempotencyKey     String   @id @map("idempotency_key")
  boundaryId         String   @map("boundary_id")
  datasetId          String   @map("dataset_id")
  contractVersion    String   @map("contract_version")
  datasetFingerprint String   @map("dataset_fingerprint")
  accepted           Boolean
  usable             Boolean
  dataRows           Int      @map("data_rows")
  acceptedRows       Int      @map("accepted_rows")
  rejectedRows       Int      @map("rejected_rows")
  warnedRows         Int      @map("warned_rows")
  /// Distinct NH-DC-#### codes only. Never the findings' detail text.
  findingCodes       String[] @map("finding_codes")
  /// EP-15 · The exact bar this decision was judged under. Retiring or superseding the policy can
  /// never alter these three values, so a historical verdict stays reproducible forever.
  admissionOutcome   String?  @map("admission_outcome")
  admissionPolicyId  String?  @map("admission_policy_id")
  admissionPolicyVersion String? @map("admission_policy_version")
  admissionPolicyHash String? @map("admission_policy_hash")
  /// EP-16 · Deterministic identifier for this decision, derived from the fields above. Nullable and
  /// never backfilled: a submission recorded before orchestration existed was never bound to an
  /// execution, and minting an identifier now would assert a binding that never happened.
  admissionDecisionId String? @map("admission_decision_id")
  submittedByActorId String   @map("submitted_by_actor_id")
  submittedByRole    String   @map("submitted_by_role")
  submittedAt        DateTime @default(now()) @map("submitted_at")

  @@index([boundaryId, submittedAt], map: "pilot_dataset_submissions_boundary_idx")
  @@index([boundaryId, admissionDecisionId], map: "pilot_dataset_submissions_decision_idx")
  @@map("pilot_dataset_submissions")
}

/// EP-14 · A versioned pilot admission policy, scoped to one tenant boundary.
///
/// The thresholds a dataset is judged against are a COMMERCIAL decision belonging to the people
/// running the pilot. They are stored per boundary and read back boundary-scoped, so one tenant's
/// fitness bar can never be applied to another tenant's data — and a policy id borrowed from
/// another tenant reads as absent rather than as that tenant's thresholds.
///
/// Append-only: a change is a NEW version, never an edit. A decision stamps the exact policy id and
/// version it used, so re-reading that version reproduces the verdict.
model PilotAdmissionPolicyRecord {
  boundaryId                   String   @map("boundary_id")
  policyId                     String   @map("policy_id")
  policyVersion                String   @map("policy_version")
  calculationMethodVersion     String   @map("calculation_method_version")
  minAcceptedRows              Int      @map("min_accepted_rows")
  minDistinctEntities          Int      @map("min_distinct_entities")
  maxRejectionRate             Float    @map("max_rejection_rate")
  maxSingleReasonShare         Float    @map("max_single_reason_share")
  maxDuplicateRate             Float    @map("max_duplicate_rate")
  minCoverageDays              Int      @map("min_coverage_days")
  requiredLifecycleStates      String[] @map("required_lifecycle_states")
  maxOrderingDefectRate        Float    @map("max_ordering_defect_rate")
  maxMissingRecommendedColumns Int      @map("max_missing_recommended_columns")
  requireProvenanceDeclaration Boolean  @map("require_provenance_declaration")
  /// EP-15 · Deterministic hash of the thresholds. Stamped into every decision, so a historical
  /// verdict carries proof of the exact bar it was judged under even if this row were ever altered.
  policyHash                   String   @map("policy_hash")
  registeredByActorId          String   @map("registered_by_actor_id")
  registeredByRole             String   @map("registered_by_role")
  registeredAt                 DateTime @default(now()) @map("registered_at")

  @@id([boundaryId, policyId, policyVersion], map: "pilot_admission_policies_pkey")
  @@index([boundaryId, policyId, registeredAt], map: "pilot_admission_policies_boundary_idx")
  @@map("pilot_admission_policies")
}

/// EP-15 · Append-only lifecycle log for an admission policy version.
///
/// Status is DERIVED from these events, never stored as an editable column — the same shape the
/// authority ledger uses. A policy is proposed by the customer side and activated by pilot
/// governance; neither may do the other's half, and no row here is ever updated or deleted.
model PilotAdmissionPolicyEventRecord {
  id            String   @id
  boundaryId    String   @map("boundary_id")
  policyId      String   @map("policy_id")
  policyVersion String   @map("policy_version")
  transition    String // PROPOSED | ACTIVATED | FROZEN | UNFROZEN | RETIRED
  actorId       String   @map("actor_id")
  actorRole     String   @map("actor_role")
  /// Why. Required on every transition — a governance decision with no stated reason is not one.
  rationale     String
  at            DateTime @default(now())

  @@index([boundaryId, policyId, policyVersion, at], map: "pilot_policy_events_identity_idx")
}

/// EP-15 · First sighting of a dataset within a boundary.
///
/// Exists for ONE rule: a policy may judge a dataset only if it was activated BEFORE that dataset
/// was first seen. Without this, someone could read a verdict, activate a laxer policy version, and
/// resubmit — tuning the bar to the result. Stores a fingerprint only: no row content, no identifiers.
model PilotDatasetSightingRecord {
  boundaryId         String   @map("boundary_id")
  datasetFingerprint String   @map("dataset_fingerprint")
  firstSeenAt        DateTime @default(now()) @map("first_seen_at")

  @@id([boundaryId, datasetFingerprint], map: "pilot_dataset_sightings_pkey")
}

/// EP-16 · One governed assessment execution over an admitted dataset.
///
/// The primary key is the DETERMINISTIC execution id — sha256 over the whole binding — so the same
/// binding cannot be scheduled twice and a changed bar cannot silently re-grade an existing run.
/// Append-only: DB triggers reject UPDATE and DELETE. There is no status column; the five states the
/// UI shows are derived from the append-only event log.
model PilotAssessmentExecutionRecord {
  executionId              String   @id(map: "pilot_assessment_executions_pkey") @map("execution_id")
  boundaryId               String   @map("boundary_id")
  datasetFingerprint       String   @map("dataset_fingerprint")
  admissionDecisionId      String   @map("admission_decision_id")
  admissionPolicyId        String   @map("admission_policy_id")
  admissionPolicyVersion   String   @map("admission_policy_version")
  admissionPolicyHash      String   @map("admission_policy_hash")
  contractVersion          String   @map("contract_version")
  assessmentPolicyId       String   @map("assessment_policy_id")
  assessmentPolicyVersion  String   @map("assessment_policy_version")
  calculationMethodVersion String   @map("calculation_method_version")
  asOf                     String   @map("as_of")
  stallThresholdDays       Int      @map("stall_threshold_days")
  currency                 String
  mappingId                String   @map("mapping_id")
  amountFormat             String   @map("amount_format")
  dateLocale               String   @map("date_locale")
  /// Optional link to a governed recovery case. When set, that case's Halt blocks this execution.
  recoveryCaseId           String?  @map("recovery_case_id")
  bindingHash              String   @map("binding_hash")
  inputHash                String   @map("input_hash")
  scheduledByActorId       String   @map("scheduled_by_actor_id")
  scheduledByRole          String   @map("scheduled_by_role")
  scheduledAt              DateTime @default(now()) @map("scheduled_at")

  @@unique([executionId, boundaryId], map: "pilot_assessment_executions_identity_boundary_unique")
  @@index([boundaryId, scheduledAt], map: "pilot_assessment_executions_boundary_idx")
  @@map("pilot_assessment_executions")
}

/// EP-16 · The de-identified input one execution runs on.
///
/// The only place accepted-row-derived values are persisted, and the reason an execution is
/// reproducible rather than merely remembered. Identifiers arrive already replaced by
/// first-appearance ordinals; free-text customer fields never reach this table; and a rejected row
/// has no representation here at all.
model PilotAssessmentExecutionInputRecord {
  executionId String   @id(map: "pilot_assessment_execution_inputs_pkey") @map("execution_id")
  boundaryId  String   @map("boundary_id")
  cycles      Json
  cycleCount  Int      @map("cycle_count")
  inputHash   String   @map("input_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([executionId, boundaryId], map: "pilot_assessment_inputs_identity_boundary_unique")
  @@map("pilot_assessment_execution_inputs")
}

/// EP-16 · Append-only lifecycle log for one execution. State is DERIVED from these rows.
model PilotAssessmentExecutionEventRecord {
  id          String   @id(map: "pilot_assessment_execution_events_pkey")
  executionId String   @map("execution_id")
  boundaryId  String   @map("boundary_id")
  transition  String // SCHEDULED | CLAIMED | RELEASED | BLOCKED | COMPLETED | FAILED
  /// The NH-AX-#### code, when the transition carries one. Null for ordinary progress.
  code        String?
  byId        String   @map("by_id")
  detail      String
  at          DateTime @default(now())

  @@index([boundaryId, executionId, at], map: "pilot_assessment_events_identity_idx")
  @@map("pilot_assessment_execution_events")
}

/// EP-16 · What an execution produced. An OBSERVATION — never a proof, never revenue, never a case.
///
/// Keyed by the execution id, so a retry after a committed finding conflicts rather than writing a
/// second answer. The content is deterministic given the binding and the input, so the conflict is
/// either a provable no-op (same hash) or a tamper signal (different hash).
model PilotAssessmentFindingRecord {
  executionId  String   @id(map: "pilot_assessment_findings_pkey") @map("execution_id")
  boundaryId   String   @map("boundary_id")
  assessmentId String   @map("assessment_id")
  finding      Json
  findingHash  String   @map("finding_hash")
  producedBy   String   @map("produced_by")
  recordedAt   DateTime @default(now()) @map("recorded_at")

  @@unique([executionId, boundaryId], map: "pilot_assessment_findings_identity_boundary_unique")
  @@map("pilot_assessment_findings")
}

/// EP-17 · Authorization for purging one execution's de-identified input, and what survives it.
///
/// Append-only and boundary-scoped. It preserves the input's hash and cycle count, so a purged
/// execution stays reproducible: re-derive the projection from the customer's CSV, hash it, and
/// compare against this row and `pilot_assessment_executions.input_hash`.
///
/// Its INSERT is validated by a database trigger against the durable event log, the task state and an
/// elapsed bound — so a purge cannot be authorized from a fact that is not the fact in question, and
/// an execution with a still-claimable task keeps its input.
model PilotAssessmentInputPurgeRecord {
  executionId            String   @id(map: "pilot_assessment_input_purges_pkey") @map("execution_id")
  boundaryId             String   @map("boundary_id")
  /// terminal_completed | terminal_blocked | abandoned_retention_elapsed
  reason                 String
  /// Preserved from the deleted input.
  inputHash              String   @map("input_hash")
  cycleCount             Int      @map("cycle_count")
  /// The policy actually applied, recorded so the elapsed-time arithmetic stays checkable later.
  terminalGraceHours     Int      @map("terminal_grace_hours")
  abandonedRetentionDays Int      @map("abandoned_retention_days")
  authorizedByActorId    String   @map("authorized_by_actor_id")
  authorizedByRole       String   @map("authorized_by_role")
  purgedAt               DateTime @default(now()) @map("purged_at")

  @@unique([executionId, boundaryId], map: "pilot_assessment_input_purges_identity_boundary_unique")
  @@index([boundaryId, purgedAt], map: "pilot_assessment_input_purges_boundary_idx")
  @@map("pilot_assessment_input_purges")
}
