// EP-2 · PostgreSQL is the authoritative persistence layer for NH recovery proofs.
//
// Design intent (consistent with the frozen Foundation, enforced — not decorative):
//  * Proof rows are IMMUTABLE, APPEND-ONLY snapshots. The numbers they carry
//    (revenueReturned = collected − baseline, clamped) are computed ONCE by the
//    domain kernel (`createApprovedProof`) and frozen; the DB never recomputes them.
//  * A correction/reversal is a NEW linked row (previousProofId + shared chainId +
//    incremented proofVersion), produced by the kernel's `reviseProof`. The original
//    is never overwritten.
//  * UPDATE and DELETE are rejected at the database level by triggers (see the
//    `ep2_immutability` migration) — direct mutation cannot bypass the kernel.
//  * Provenance/version fields (policyVersion, baselineVersion, proofVersion,
//    confidenceMethodologyVersion, approvedBy, createdAt/approvedAt, persistedAt)
//    are persisted so every counted number stays explainable and reproducible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Immutable, append-only snapshot of an approved (or revised) recovery proof.
/// Mirrors the domain `Proof` interface; money is stored in minor units (BigInt).
model Proof {
  proofId                      String   @id
  recoveryCaseId               String
  chainId                      String
  proofVersion                 Int
  previousProofId              String?
  status                       String // Approved | Reversed | Superseded | Corrected (kernel-controlled)
  currency                     String
  collectedMinor               BigInt
  baselineMinor                BigInt
  revenueReturnedMinor         BigInt // frozen by the kernel; DB stores, never derives
  excludedRecoveryMinor        BigInt
  exclusionStatement           String
  recoveryReason               String
  attribution                  String
  evidenceRefs                 String[]
  baselineId                   String
  baselineMethodId             String
  baselineVersion              Int
  baselineLockPolicy           String
  policyVersion                String
  confidenceMethodologyVersion String
  proofThresholdUsed           Float
  confidenceUsed               Float
  approvedBy                   String
  createdAt                    DateTime
  approvedAt                   DateTime
  persistedAt                  DateTime @default(now()) // provenance: DB write time

  // EP-8.1 · H1 concurrency backstop: at most one row per (chainId, proofVersion) — the
  // exact invariant effectiveProofs() (src/domain/proof.ts) already assumes. A second,
  // complementary partial index UNIQUE(previousProofId) WHERE previousProofId IS NOT NULL
  // (a proof may be superseded at most once) is added via raw SQL in the
  // ep8_1_chain_fork_guard migration — Prisma's @@unique cannot express the WHERE clause
  // NULLs must be exempt from.
  @@unique([chainId, proofVersion])
  @@index([chainId])
  @@index([recoveryCaseId])
  @@index([previousProofId])
}

/// Append-only authority ledger (EP-4): who did what, in which role, on which case.
/// Records every governed action (Author/Approve/Verify/Flag/Halt) with the actor
/// identity, role, policy version, and timestamp. Separation-of-duty enforcement reads
/// this ledger; it is immutable at the DB level so authority history stays auditable.
model AuthorityEvent {
  id             String   @id
  recoveryCaseId String
  actorId        String
  role           String
  action         String // Author | Approve | Verify | Flag | Halt
  policyVersion  String
  at             DateTime @default(now())

  @@index([recoveryCaseId])
  @@index([actorId])
}

/// EP-8.1 · Immutable, append-only baseline snapshot. Establish and lock happen as ONE
/// insert (`lockedAt` is the server clock, never client-suppliable). A proof's baseline
/// amount/method/version come ONLY from the snapshot a case references, never from the
/// approval request body. A correction is a NEW row (`supersedes`); the prior snapshot,
/// and every proof that already stamped it, is never touched.
model BaselineSnapshot {
  baselineId        String   @id
  recoveryCaseId    String
  calculatedMinor   BigInt
  currency          String
  method            String
  methodVersion     Int
  sourceRefs        String[]
  effectiveAt       DateTime
  establishedBy     String
  establishedByRole String
  lockedAt          DateTime @default(now())
  supersedes        String?

  @@index([recoveryCaseId])
}

/// EP-8.1 · Append-only, pre-proof evidence ingestion. Immutable at the DB level.
/// `evidenceRole` and `trustClassification`/`beneficiaryControl` are DERIVED server-side at
/// ingestion (never client-asserted) — see server/domain/evidenceRole.ts and the domain's
/// `makeEvidence`. `roleMapVersion` freezes which allowlist version produced the
/// classification, so a future mapping change can never reinterpret historical evidence.
/// `observedAt` is recorded but is a claimed, non-authoritative fact — see `ingestedAt`
/// (server clock) for the positive timing signal actually used by the temporal trust gate.
/// The partial unique index below makes an outcome-role source record single-use across
/// every recovery, not just within one case.
model EvidenceRecord {
  evidenceId          String   @id
  recoveryCaseId      String
  proofId             String?
  sourceSystem        String
  sourceRecordId      String
  evidenceType        String
  observedAt          DateTime
  amountMinor         BigInt?
  currency            String?
  trustClassification String // "independent" | "beneficiary_controlled" — derived, never asserted
  beneficiaryControl  Boolean
  evidenceRole        String // "outcome" | "supporting" — derived, never asserted
  roleMapVersion      String
  ingestedBy          String
  ingestedByRole      String
  ingestedAt          DateTime @default(now()) // authoritative server timestamp
  sourceVerification  Json?
  note                String?
  // A partial unique index (sourceSystem, sourceRecordId) WHERE evidenceRole='outcome' is
  // added via raw SQL in the ep8_1_evidence_hardening migration — Prisma's declarative
  // @@unique cannot express a WHERE clause, and the constraint must apply to outcome-role
  // rows only (supporting evidence may legitimately be cited more than once).

  @@index([recoveryCaseId])
}

/// EP-12A · Durable execution state for observation-only agents. A task is always scoped to
/// one boundary; its result may contain CandidateSignals only and grants no case/proof authority.
/// Runtime transitions use raw SQL for SKIP LOCKED claiming and fenced lease predicates.
model AgentTaskRecord {
  taskId         String                 @id(map: "agent_tasks_pkey") @map("task_id")
  boundaryId     String                 @map("boundary_id")
  agentId        String                 @map("agent_id")
  idempotencyKey String                 @map("idempotency_key")
  payload        Json
  status         String
  attempt        Int                    @default(0)
  notBefore      DateTime               @map("not_before") @db.Timestamptz(3)
  leaseOwner     String?                @map("lease_owner")
  leaseToken     String?                @map("lease_token")
  leaseExpiresAt DateTime?              @map("lease_expires_at") @db.Timestamptz(3)
  fencingEpoch   BigInt                 @default(0) @map("fencing_epoch")
  result         Json?
  lastError      String?                @map("last_error")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @default(now()) @map("updated_at") @db.Timestamptz(3)
  events         AgentTaskEventRecord[]

  @@unique([boundaryId, agentId, idempotencyKey], map: "agent_tasks_boundary_agent_idempotency_unique")
  @@unique([taskId, boundaryId, agentId], map: "agent_tasks_identity_boundary_unique")
  @@map("agent_tasks")
}

/// Append-only audit history for every durable AgentTask transition. State and event are written
/// in the same PostgreSQL transaction; UPDATE/DELETE/TRUNCATE are rejected by DB triggers.
model AgentTaskEventRecord {
  eventId      String          @id(map: "agent_task_events_pkey") @map("event_id")
  sequence     BigInt          @unique(map: "agent_task_events_sequence_key") @default(autoincrement()) @map("event_sequence")
  taskId       String          @map("task_id")
  boundaryId   String          @map("boundary_id")
  agentId      String          @map("agent_id")
  workerId     String?         @map("worker_id")
  fencingEpoch BigInt          @map("fencing_epoch")
  attempt      Int
  kind         String
  metadata     Json
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  task         AgentTaskRecord @relation(fields: [taskId, boundaryId, agentId], references: [taskId, boundaryId, agentId], onDelete: Restrict, onUpdate: Restrict, map: "agent_task_events_task_boundary_agent_fkey")

  @@index([taskId, sequence], map: "agent_task_events_task_sequence_idx")
  @@index([boundaryId, agentId, sequence], map: "agent_task_events_boundary_agent_sequence_idx")
  @@map("agent_task_events")
}

/// EP-12B · A detector result that crossed the universal admission gate. It remains a
/// hypothesis until a human operator accepts it and explicitly promotes it to a RecoveryCase.
model AgentCaseCandidateRecord {
  candidateId String   @id(map: "agent_case_candidates_pkey") @map("candidate_id")
  dedupeKey   String   @unique(map: "agent_case_candidates_dedupe_key_key") @map("dedupe_key")
  boundaryId  String   @map("boundary_id")
  agentId     String   @map("agent_id")
  signal      Json
  status      String   @default("pending_review")
  submittedAt DateTime @map("submitted_at") @db.Timestamptz(3)
  persistedAt DateTime @default(now()) @map("persisted_at") @db.Timestamptz(3)

  @@unique([candidateId, boundaryId], map: "agent_case_candidates_identity_boundary_unique")
  @@index([boundaryId, status, submittedAt], map: "agent_case_candidates_review_queue_idx")
  @@map("agent_case_candidates")
}

/// Immutable human decision on a candidate. One candidate can be reviewed once; an accepted
/// decision stays visible until the candidate has a durable RecoveryCase root.
model AgentCaseCandidateReviewRecord {
  reviewId      String   @id(map: "agent_case_candidate_reviews_pkey") @map("review_id")
  candidateId   String   @unique(map: "agent_case_candidate_reviews_candidate_key") @map("candidate_id")
  boundaryId    String   @map("boundary_id")
  decision      String
  reason        String
  actorId       String   @map("actor_id")
  actorRole     String   @map("actor_role")
  policyVersion String   @map("policy_version")
  decidedAt     DateTime @default(now()) @map("decided_at") @db.Timestamptz(3)

  @@index([boundaryId, decidedAt], map: "agent_case_candidate_reviews_boundary_idx")
  @@map("agent_case_candidate_reviews")
}

/// EP-12E · Authoritative root of every governed recovery workflow. No baseline, evidence,
/// proof or authority mutation is valid in production without this row.
model RecoveryCaseRecord {
  recoveryCaseId    String   @id(map: "recovery_cases_pkey") @map("recovery_case_id")
  boundaryId        String   @map("boundary_id")
  sourceCandidateId String   @unique(map: "recovery_cases_source_candidate_key") @map("source_candidate_id")
  recoveryType      String   @map("recovery_type")
  sourceRef         String   @map("source_ref")
  amountAtRiskMinor BigInt   @map("amount_at_risk_minor")
  currency          String
  detectorVersion   String   @map("detector_version")
  openedByActorId   String   @map("opened_by_actor_id")
  openedByRole      String   @map("opened_by_role")
  policyVersion     String   @map("policy_version")
  openedAt          DateTime @map("opened_at") @db.Timestamptz(3)
  persistedAt       DateTime @default(now()) @map("persisted_at") @db.Timestamptz(3)

  @@unique([sourceCandidateId, boundaryId], map: "recovery_cases_candidate_boundary_unique")
  @@index([boundaryId, openedAt], map: "recovery_cases_boundary_opened_idx")
  @@map("recovery_cases")
}

/// EP-13 · Record of one customer pilot dataset submission. It exists for ONE reason: to make a
/// repeated upload recognisable, so the same exposure is not assessed twice. It is deliberately
/// NOT an evidence, case or proof record and grants no authority whatsoever.
///
/// WHAT IT STORES: the tenant boundary, the customer's dataset label, the deterministic
/// idempotency key, the file fingerprint, counts, and the VALIDATION CODES produced.
/// WHAT IT NEVER STORES: uploaded row content, customer identifiers, monetary values, or the
/// `detail` text of a finding (which can echo a customer value). A rejected row is reported to the
/// uploader and then forgotten — it is never persisted.
model PilotDatasetSubmissionRecord {
  idempotencyKey     String   @id @map("idempotency_key")
  boundaryId         String   @map("boundary_id")
  datasetId          String   @map("dataset_id")
  contractVersion    String   @map("contract_version")
  datasetFingerprint String   @map("dataset_fingerprint")
  accepted           Boolean
  usable             Boolean
  dataRows           Int      @map("data_rows")
  acceptedRows       Int      @map("accepted_rows")
  rejectedRows       Int      @map("rejected_rows")
  warnedRows         Int      @map("warned_rows")
  /// Distinct NH-DC-#### codes only. Never the findings' detail text.
  findingCodes       String[] @map("finding_codes")
  submittedByActorId String   @map("submitted_by_actor_id")
  submittedByRole    String   @map("submitted_by_role")
  submittedAt        DateTime @default(now()) @map("submitted_at")

  @@index([boundaryId, submittedAt], map: "pilot_dataset_submissions_boundary_idx")
  @@map("pilot_dataset_submissions")
}
